# Copy to .env.local and point at your running Django backend.
# For Vercel deployments, set this same variable (NEXT_PUBLIC_BACKEND_API_URL) under
# Project Settings -> Environment Variables instead -- .env.local is gitignored and
# NEXT_PUBLIC_* vars are baked in at build time, so Vercel never sees this file.
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000/api
